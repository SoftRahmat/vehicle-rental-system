PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/vehicle_rental
# Optional direct database endpoint for Prisma migrations and TypedSQL generation.
DIRECT_URL=postgresql://username:password@localhost:5432/vehicle_rental
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:4200

# Google OAuth (the callback must also be registered in Google Cloud)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Google Routes API. Restrict this server key to the Routes API and your backend.
GOOGLE_MAPS_SERVER_KEY=replace-with-google-routes-server-key
RIDES_CURRENCY=MYR
# Card rides authorize the estimate plus the greater of these two MYR buffers.
RIDES_CARD_AUTH_BUFFER_PERCENT=25
RIDES_CARD_AUTH_BUFFER_MINIMUM=20
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:support@your-domain.example

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend email notifications
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Roadly <bookings@your-domain.example>

# Twilio SMS notifications
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15550000000
