model User {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @db.VarChar(100)
  role                    String                  @default("customer") @db.VarChar(50)
  email                   String                  @unique @db.VarChar(150)
  password                String?
  phone                   String?                 @db.VarChar(16)
  createdAt               DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime?               @default(now()) @map("updated_at") @db.Timestamp(6)
  googleSubject           String?                 @map("google_subject")
  avatarUrl               String?                 @map("avatar_url")
  authProvider            String?                 @default("password") @map("auth_provider") @db.VarChar(30)
  emailVerified           Boolean?                @default(false) @map("email_verified")
  phoneVerifiedAt         DateTime?               @map("phone_verified_at") @db.Timestamp(6)
  exchangeCodes           AuthExchangeCode[]
  bookings                Booking[]
  verificationCodes       PhoneVerificationCode[]
  supportTickets          SupportTicket[]         @relation("SupportCustomer")
  assignedTickets         SupportTicket[]         @relation("SupportAssignee")
  supportMessages         SupportMessage[]
  driverProfile           DriverProfile?
  passengerRides          Ride[]                  @relation("RidePassenger")
  rideStatusEvents        RideStatusEvent[]       @relation("RideEventActor")
  rideNotifications       RideNotification[]
  pushSubscriptions       PushSubscription[]
  rideReviews             RideReview[]            @relation("ReviewPassenger")
  moderatedReviews        RideReview[]            @relation("ReviewModerator")
  approvedPayouts         DriverPayout[]          @relation("PayoutApprover")
  driverAdjustments       DriverAdjustment[]      @relation("AdjustmentCreator")
  reviewedDriverDocuments DriverDocument[]        @relation("DriverDocumentReviewer")
  assignedDriverIncidents DriverIncident[]        @relation("IncidentAssignee")
  resolvedDriverIncidents DriverIncident[]        @relation("IncidentResolver")
  driverRiskActions       DriverRiskAction[]      @relation("RiskActionAdmin")
  authSessions            AuthSession[]
  authAccounts            AuthAccount[]

  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_auth_sessions_user_id")
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
  @@map("auth_sessions")
}

model AuthAccount {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "auth_accounts_provider_account_key")
  @@index([userId], map: "idx_auth_accounts_user_id")
  @@map("auth_accounts")
}

model AuthVerification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([identifier], map: "idx_auth_verifications_identifier")
  @@map("auth_verifications")
}

model AuthExchangeCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("auth_exchange_codes")
}

model PhoneVerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  phone     String    @db.VarChar(16)
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_phone_verification_user")
  @@map("phone_verification_codes")
}
