model SupportTicket {
  id              Int              @id @default(autoincrement())
  customerId      Int              @map("customer_id")
  bookingId       Int?             @map("booking_id")
  assignedAdminId Int?             @map("assigned_admin_id")
  subject         String           @db.VarChar(160)
  category        String           @default("general") @db.VarChar(40)
  priority        String           @default("normal") @db.VarChar(20)
  status          String           @default("open") @db.VarChar(30)
  lastMessageAt   DateTime         @default(now()) @map("last_message_at") @db.Timestamp(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamp(6)
  customer        User             @relation("SupportCustomer", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedAdmin   User?            @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages        SupportMessage[]

  @@index([customerId, lastMessageAt(sort: Desc)], map: "idx_support_tickets_customer")
  @@index([status, lastMessageAt(sort: Desc)], map: "idx_support_tickets_status")
  @@index([assignedAdminId, status], map: "idx_support_tickets_assignee")
  @@map("support_tickets")
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int           @map("ticket_id")
  senderId  Int           @map("sender_id")
  body      String
  readAt    DateTime?     @map("read_at") @db.Timestamp(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticketId, createdAt], map: "idx_support_messages_ticket")
  @@index([ticketId, readAt], map: "idx_support_messages_unread")
  @@map("support_messages")
}
